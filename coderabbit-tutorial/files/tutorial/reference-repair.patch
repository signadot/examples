+package driver
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/signadot/hotrod/services/location"
+)
+
+func TestDispatchRequestUnmarshalJSON(t *testing.T) {
+	tests := []struct {
+		name          string
+		payload       string
+		wantPickupID  int64
+		wantDropoffID int64
+	}{
+		{
+			name:          "deployed camelCase producer",
+			payload:       `{"pickupLocation":{"id":1},"dropoffLocation":{"id":123}}`,
+			wantPickupID:  1,
+			wantDropoffID: 123,
+		},
+		{
+			name:          "canonical snake_case producer",
+			payload:       `{"pickup_location":{"id":2},"dropoff_location":{"id":456}}`,
+			wantPickupID:  2,
+			wantDropoffID: 456,
+		},
+		{
+			name:          "canonical fields take precedence",
+			payload:       `{"pickup_location":{"id":3},"pickupLocation":{"id":99},"dropoff_location":{"id":789},"dropoffLocation":{"id":999}}`,
+			wantPickupID:  3,
+			wantDropoffID: 789,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var request DispatchRequest
+			if err := json.Unmarshal([]byte(tt.payload), &request); err != nil {
+				t.Fatal(err)
+			}
+			if request.PickupLocation == nil || request.PickupLocation.ID != tt.wantPickupID {
+				t.Errorf("PickupLocation = %#v, want ID %d", request.PickupLocation, tt.wantPickupID)
+			}
+			if request.DropoffLocation == nil || request.DropoffLocation.ID != tt.wantDropoffID {
+				t.Errorf("DropoffLocation = %#v, want ID %d", request.DropoffLocation, tt.wantDropoffID)
+			}
+		})
+	}
+}
+
+func TestDispatchRequestUnmarshalJSONCanonicalNullTakesPrecedence(t *testing.T) {
+	const payload = `{"pickup_location":null,"pickupLocation":{"id":99}}`
+	var request DispatchRequest
+	if err := json.Unmarshal([]byte(payload), &request); err != nil {
+		t.Fatal(err)
+	}
+	if request.PickupLocation != nil {
+		t.Errorf("PickupLocation = %#v, want nil", request.PickupLocation)
+	}
+}
+
+func TestDispatchRequestMarshalJSONUsesCanonicalFields(t *testing.T) {
+	request := DispatchRequest{
+		PickupLocation:  &location.Location{ID: 1},
+		DropoffLocation: &location.Location{ID: 123},
+	}
+	data, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"pickup_location", "dropoff_location"} {
+		if _, ok := fields[name]; !ok {
+			t.Errorf("canonical field %q missing from %s", name, data)
+		}
+	}
+	for _, name := range []string{"pickupLocation", "dropoffLocation"} {
+		if _, ok := fields[name]; ok {
+			t.Errorf("legacy field %q unexpectedly emitted in %s", name, data)
+		}
+	}
+}
