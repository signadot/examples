+// UnmarshalJSON accepts the legacy camelCase fields used by deployed frontend
+// producers while keeping snake_case as the canonical dispatch contract.
+func (r *DispatchRequest) UnmarshalJSON(data []byte) error {
+	var fields struct {
+		PickupLocation        json.RawMessage `json:"pickup_location"`
+		DropoffLocation       json.RawMessage `json:"dropoff_location"`
+		LegacyPickupLocation  json.RawMessage `json:"pickupLocation"`
+		LegacyDropoffLocation json.RawMessage `json:"dropoffLocation"`
+	}
+	if err := json.Unmarshal(data, &fields); err != nil {
+		return err
+	}
+
+	pickupLocation, err := decodeLocation(fields.PickupLocation, fields.LegacyPickupLocation)
+	if err != nil {
+		return err
+	}
+	dropoffLocation, err := decodeLocation(fields.DropoffLocation, fields.LegacyDropoffLocation)
+	if err != nil {
+		return err
+	}
+
+	r.PickupLocation = pickupLocation
+	r.DropoffLocation = dropoffLocation
+	return nil
+}
+
+func decodeLocation(current, legacy json.RawMessage) (*location.Location, error) {
+	data := current
+	if data == nil {
+		data = legacy
+	}
+	if data == nil {
+		return nil, nil
+	}
+
+	var result *location.Location
+	if err := json.Unmarshal(data, &result); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
