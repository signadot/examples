<?xml version="1.0" encoding="UTF-8"?>
<!-- Without a logback config the root logger defaults to DEBUG, which floods
     the worker logs (including the routing cache on every task check). -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
