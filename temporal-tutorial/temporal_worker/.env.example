# Copy to .env and adjust for your environment:
#   cp .env.example .env
#   python -m dotenv -f .env -- python main.py

# Task queue this worker polls
TASK_QUEUE=money-transfer

# Temporal server address
TEMPORAL_SERVER_URL=localhost:7233

# Signadot routeserver (reachable via `signadot local connect` when developing
# locally against a cluster with the Signadot operator installed)
ROUTES_API_ROUTE_SERVER_ADDR=http://routeserver.signadot.svc:7778

# Baseline workload this worker corresponds to
ROUTES_API_BASELINE_KIND=Deployment
ROUTES_API_BASELINE_NAMESPACE=temporal
ROUTES_API_BASELINE_NAME=temporal-worker

# How often to refresh the routing rules cache
ROUTES_API_REFRESH_INTERVAL_SECONDS=120

# Set only on sandboxed workers. In-cluster, Signadot sets this automatically
# on forked workloads; leave unset for the baseline worker.
# SIGNADOT_SANDBOX_NAME=my-sandbox
